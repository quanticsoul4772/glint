# Copy to $GLINT_HOME/.env (GLINT_HOME defaults to the repo's parent folder). Never commit the real file.
# Replay mode of the Bank Desk, the tests and the gates need none of these.

# Bank Desk live mode: the deployed Glimmer endpoint (modal deploy src/glint/glimmer_serve.py) and its proxy auth
GLINT_GLIMMER_URL=https://your-endpoint.modal.run   # the URL modal deploy prints
MODAL_PROXY_KEY=your-modal-proxy-auth-key
MODAL_PROXY_SECRET=your-modal-proxy-auth-secret

# Meta Model API (Muse Spark as the customer and judge)
MODEL_API_KEY=your-meta-model-api-key

# Optional: Spark Open on Baseten as the customer when Meta's API cannot serve it
BASETEN_API_KEY=your-baseten-key
